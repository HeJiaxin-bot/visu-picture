{
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "cypress.config.*",
    "nightwatch.conf.*",
    "playwright.config.*"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],

    "lib": ["ES2023", "ESNext.Array", "ESNext.Collection"],
    "target": "ES2022",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  }
}