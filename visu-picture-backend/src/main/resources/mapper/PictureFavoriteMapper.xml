<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.visupicture.mapper.PictureFavoriteMapper">

    <resultMap id="BaseResultMap" type="com.visupicture.model.entity.PictureFavorite">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="pictureId" column="pictureId" jdbcType="BIGINT"/>
            <result property="userId" column="userId" jdbcType="BIGINT"/>
            <result property="createTime" column="createTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,pictureId,userId,
        createTime
    </sql>

    <!--
      幂等插入收藏记录（与点赞同构）
      唯一索引 uk_pictureId_userId + INSERT IGNORE，重复收藏返回 0，不重复计数。
    -->
    <insert id="insertIgnore">
        INSERT IGNORE INTO picture_favorite (pictureId, userId)
        VALUES (#{pictureId}, #{userId})
    </insert>
</mapper>
