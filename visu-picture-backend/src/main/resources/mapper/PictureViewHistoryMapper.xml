<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.visupicture.mapper.PictureViewHistoryMapper">

    <resultMap id="BaseResultMap" type="com.visupicture.model.entity.PictureViewHistory">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="userId" column="userId" jdbcType="BIGINT"/>
            <result property="pictureId" column="pictureId" jdbcType="BIGINT"/>
            <result property="viewTime" column="viewTime" jdbcType="TIMESTAMP"/>
            <result property="viewCount" column="viewCount" jdbcType="INTEGER"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,userId,pictureId,
        viewTime,viewCount
    </sql>

    <!--
      记录一次浏览：同一用户同一图片只保留一条，重复查看刷新时间并累加次数。
      依赖唯一索引 uk_userId_pictureId + ON DUPLICATE KEY UPDATE，
      单条 SQL 完成「有则更新、无则插入」，无需先查询再判断，因此没有竞态。
      返回值：插入为 1，更新为 2，值未变化为 0。
    -->
    <insert id="recordView">
        INSERT INTO picture_view_history (userId, pictureId, viewTime, viewCount)
        VALUES (#{userId}, #{pictureId}, NOW(), 1)
        ON DUPLICATE KEY UPDATE viewTime = NOW(), viewCount = viewCount + 1
    </insert>
</mapper>
