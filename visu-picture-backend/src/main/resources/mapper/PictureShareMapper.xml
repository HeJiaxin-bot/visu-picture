<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.visupicture.mapper.PictureShareMapper">

    <resultMap id="BaseResultMap" type="com.visupicture.model.entity.PictureShare">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="shareCode" column="shareCode" jdbcType="VARCHAR"/>
            <result property="pictureId" column="pictureId" jdbcType="BIGINT"/>
            <result property="userId" column="userId" jdbcType="BIGINT"/>
            <result property="expireTime" column="expireTime" jdbcType="TIMESTAMP"/>
            <result property="viewCount" column="viewCount" jdbcType="INTEGER"/>
            <result property="createTime" column="createTime" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="updateTime" jdbcType="TIMESTAMP"/>
            <result property="isDelete" column="isDelete" jdbcType="TINYINT"/>
    </resultMap>

    <!--
      注意：isDelete 是逻辑删除字段（撤销分享即置 1），
      直接用 Base_Column_List 查询会包含已撤销的链接。
      走 MyBatis-Plus 的 selectOne/selectList 会自动追加 isDelete = 0。
    -->
    <sql id="Base_Column_List">
        id,shareCode,pictureId,
        userId,expireTime,viewCount,
        createTime,updateTime,isDelete
    </sql>
</mapper>
