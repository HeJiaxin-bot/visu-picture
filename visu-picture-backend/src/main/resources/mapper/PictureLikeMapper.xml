<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.visupicture.mapper.PictureLikeMapper">

    <resultMap id="BaseResultMap" type="com.visupicture.model.entity.PictureLike">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="pictureId" column="pictureId" jdbcType="BIGINT"/>
            <result property="userId" column="userId" jdbcType="BIGINT"/>
            <result property="createTime" column="createTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,pictureId,userId,
        createTime
    </sql>

    <!--
      幂等插入点赞记录（点赞去重的核心）
      依赖唯一索引 uk_pictureId_userId + INSERT IGNORE：
        已点赞 -> 插入被忽略并返回 0
        未点赞 -> 插入成功返回 1
      调用方据返回值决定是否对 picture.likeCount 计数，从根本上杜绝重复点赞刷高计数。
      与 PictureLikeMapper#insertIgnore 上的 @Insert 注解等价，保留此 XML 便于统一维护 SQL。
    -->
    <insert id="insertIgnore">
        INSERT IGNORE INTO picture_like (pictureId, userId)
        VALUES (#{pictureId}, #{userId})
    </insert>
</mapper>
